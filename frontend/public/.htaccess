Options -Indexes -MultiViews
DirectoryIndex index.html index.php
DirectorySlash On

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Enforce HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Admin Routes (both /admin and /valobasa serve the full admin panel)
  RewriteRule ^admin/?$ /valobasa/index.html [L]
  RewriteRule ^valobasa/?$ /valobasa/index.html [L]

  # 3. Serve physical files directly if they exist (images, js, css, etc.)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 4. Check if directory has an index.html (primary for trailingSlash: true)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 5. Product Routes:
  # 5a. If physical product directory with index.html exists, serve it
  RewriteCond %{DOCUMENT_ROOT}/product/$1/index.html -f [OR]
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^products?/([^/]+)/?$ /product/$1/index.html [L]

  # 5b. If physical product .html exists, serve it
  RewriteCond %{DOCUMENT_ROOT}/product/$1.html -f [OR]
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^products?/([^/]+)/?$ /product/$1.html [L]

  # 5c. Dynamic SPA fallback for any /product/* and /products/* routes not pre-rendered:
  RewriteRule ^products?/([^/]+)/?$ /product/default/index.html [L]

  # 6. Category Routes:
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^category/([^/]+)/?$ /category/$1/index.html [L]

  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^category/([^/]+)/?$ /category/$1.html [L]

  RewriteRule ^category/([^/]+)/?$ /category/index.html [L]

  # 7. Landing Routes:
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^landing/([^/]+)/?$ /landing/$1/index.html [L]

  RewriteRule ^landing/([^/]+)/?$ /landing/seasonal-offer/index.html [L]

  # 8. Clean URLs for standard pages: map /page to page/index.html or page.html
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 9. Fallback to 404 page for any other missing routes
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ 404.html [L]
</IfModule>

# Custom Error Document
ErrorDocument 404 /404.html

# ─── GZIP & BROTLI COMPRESSION ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml image/x-icon font/woff font/woff2
</IfModule>

# ─── BROWSER CACHING HEADERS ────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML & JSON: Do not cache aggressively (always fetch fresh)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"

  # Static Next.js Bundles, Fonts, and Images: Cache 1 year
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Cache Control for HTML & Data
  <FilesMatch "\.(html|htm|txt|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Cache Control for Next.js immutable assets
  <FilesMatch "\.(js|css|woff2|woff|ttf|png|jpg|jpeg|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Security Headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
