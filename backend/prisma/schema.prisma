// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  phone        String?
  role         String    @default("Customer") // SuperAdmin, Manager, Salesman, Rider, Customer
  points       Int       @default(0) // Loyalty Points / GlowGoodly Balance
  status       String    @default("Active") // Active, Suspicious, Fraud
  addresses    Address[]
  orders       Order[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addressLine String   @db.Text
  city        String
  zone        String   // Inside Dhaka, Outside Dhaka
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Brand {
  id         String    @id @default(uuid())
  name       String    @unique
  logoUrl    String?   @db.Text
  isTopBrand Boolean   @default(false)
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Category {
  id            String     @id @default(uuid())
  name          String     @unique
  imageUrl      String?    @db.Text
  parentId      String?    // For Sub-categories
  parent        Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: Cascade)
  subCategories Category[] @relation("SubCategories")
  products      Product[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Product {
  id              String         @id @default(uuid())
  name            String
  description     String         @db.Text
  ingredients     String?        @db.Text
  howToUse        String?        @db.Text
  brandId         String
  brand           Brand          @relation(fields: [brandId], references: [id])
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  status          String         @default("Active") // Active, Inactive
  metaTitle       String?
  metaDescription String?        @db.Text
  metaKeywords    String?        @db.Text
  campaignName    String?        // e.g. BOGO, COMBO, CLEARANCE, EXCLUSIVE
  images          ProductImage[]
  variants        Variant[]
  reviews         Review[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@index([campaignName])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String   @db.Text
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Variant {
  id            String         @id @default(uuid())
  productId     String
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String         // e.g. "Shade 01", "100ml", "Red"
  shadeColor    String?        // Hex color code (e.g. #FF5733) for cosmetics
  sizeValue     String?        // e.g. "50ml", "100g"
  price         Float
  discountPrice Float?         // Promotional price
  costPrice     Float?         // Purchase price
  stock         Int            @default(0)
  sku           String         @unique
  imageUrl      String?        @db.Text
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([productId])
}

model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique
  customerId     String?
  customer       User?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName   String
  customerEmail  String
  customerPhone  String
  address        String      @db.Text
  zone           String      // Inside Dhaka, Outside Dhaka
  deliveryCharge Float
  subTotal       Float
  discount       Float       @default(0)
  total          Float
  paymentStatus  String      @default("Pending") // Pending, Paid, Failed
  paymentMethod  String      @default("COD") // COD, bKash, SSLCommerz, aamarpay
  orderStatus    String      @default("Pending") // Pending, Processing, Shipped, Delivered, Cancelled
  notes          String?     @db.Text
  trackingLink   String?     @db.Text
  salesmanId     String?     // Track which salesperson handled it
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  variantName String
  quantity    Int
  price       Float
  total       Float
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String    // Fixed, Percentage
  discountValue Float
  minOrderValue Float     @default(0)
  maxDiscount   Float?
  expiryDate    DateTime
  usageLimit    Int       @default(1)
  timesUsed     Int       @default(0)
  categoryLimit String?   @db.Text // Comma-separated category IDs
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. "SMS_API_KEY", "PAYMENT_MERCHANT_ID", etc.
  value     String   @db.LongText
  updatedAt DateTime @updatedAt
}

model Review {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerName String
  rating       Int      // 1 to 5
  comment      String   @db.Text
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model PromoBanner {
  id             String   @id @default(uuid())
  title          String   // Used as alt text and aria-label (SEO friendly)
  imageUrl       String   @db.Text // Full-width desktop banner image URL
  mobileImageUrl String?  @db.Text // Mobile version banner image URL
  tabletImageUrl String?  @db.Text // Tablet version banner image URL
  linkUrl        String?  @db.Text // Optional click-through link
  bgColor        String   @default("#1a1a2e") // Fallback background color
  page           String   @default("Homepage") // Homepage, Hair Care 101, Skin Care 101, Makeup 101
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0) // For ordering multiple banners
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Vendor {
  id          String   @id @default(uuid())
  name        String
  contactName String?
  email       String?  @unique
  phone       String?
  address     String?  @db.Text
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Campaign {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  bannerUrl   String?  @db.Text
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InventoryLog {
  id        String   @id @default(uuid())
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int      // Positive for stock in, Negative for stock out
  reason    String   // e.g. "Restock", "Sale", "Damage", "Return"
  userId    String?  // Staff who made the change
  createdAt DateTime @default(now())
}

model Visitor {
  id        String   @id @default(uuid())
  ipAddress String?
  device    String?  @db.Text
  browser   String?  @db.Text
  lastVisit DateTime @default(now())
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(uuid())
  chatId    String   // Session ID or User ID to group the conversation
  sender    String   // "Customer" or "Admin"
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String   @db.Text
  imageUrl  String?  @db.Text
  linkUrl   String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FcmToken {
  id        String   @id @default(uuid())
  token     String   @unique
  device    String?  // Desktop, Android, iOS, Chrome, Firefox, Safari
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id        String     @id @default(uuid())
  title     String
  url       String     @db.Text
  location  String     @default("Header") // Header or Footer
  parentId  String?
  parent    MenuItem?  @relation("SubMenuItems", fields: [parentId], references: [id], onDelete: Cascade)
  subItems  MenuItem[] @relation("SubMenuItems")
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CmsPage {
  id              String   @id @default(uuid())
  slug            String   @unique // e.g. "about", "authenticity", "privacy-policy"
  title           String
  contentHtml     String   @db.LongText
  metaTitle       String?
  metaDescription String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
