# ─── GLOWGOODLY BACKEND PRODUCTION ENVIRONMENT CONFIGURATION ────────────────
# Copy this file to '.env' inside your backend application root in cPanel.

# Application Port (cPanel Passenger sets process.env.PORT automatically, but fallback is 5000)
PORT=5000
NODE_ENV=production

# ─── MYSQL DATABASE CONNECTION ───────────────────────────────────────────────
# Option 1 (Recommended): Discrete credentials (prevents URI special character bugs)
DB_HOST=localhost
DB_PORT=3306
DB_USER=sitecadh_alamain
DB_PASSWORD=YourDatabasePasswordHere
DB_NAME=sitecadh_glowgoodly_db

# Option 2: Full DATABASE_URL format: mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/DB_NAME
DATABASE_URL="mysql://sitecadh_alamain:YourDatabasePasswordHere@localhost:3306/sitecadh_glowgoodly_db"

# ─── SECURITY & AUTHENTICATION ──────────────────────────────────────────────
# Generate a long random secret string for signing JWT tokens
JWT_SECRET="glowgoodly_production_jwt_secure_key_987654321_secret"

# Frontend Storefront URL for CORS Authorization
FRONTEND_URL="https://shop.glowgoodly.com"

# ─── OPTIONAL PAYMENT & INTEGRATION SETTINGS ────────────────────────────────
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# BKASH_MERCHANT_NUMBER=01609013011
