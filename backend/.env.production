PORT=5000
NODE_ENV=production
# cPanel MySQL Database URL Format: mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME?connection_limit=5&pool_timeout=20
DATABASE_URL="mysql://cpanel_user:cpanel_password@localhost:3306/cpanel_glowgoodly?connection_limit=5&pool_timeout=20"
ADMIN_EMAIL="admin@glowgoodly.com"
ADMIN_PASSWORD="ChangeMeToStrongPassword123!"
JWT_SECRET="glowgoodly_production_secure_jwt_secret_key_change_me_987654321"
FRONTEND_URL="https://glowgoodly.com"
ALLOW_DEV_AUTH_BYPASS="false"

# bKash Merchant Payment Gateway API Credentials
BKASH_MODE="live"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_BASE_URL="https://tokenized.pay.bka.sh"
BKASH_MERCHANT_NUMBER="01XXXXXXXXX"

# Pathao Courier Merchant API Credentials (Aladdin v1)
PATHAO_MODE="live"
PATHAO_BASE_URL="https://api-hermes.pathao.com"
PATHAO_CLIENT_ID=""
PATHAO_CLIENT_SECRET=""
PATHAO_USERNAME=""
PATHAO_PASSWORD=""
PATHAO_STORE_ID=""

# Courier API Credentials (Steadfast / Pathao / RedX)
COURIER_API_URL="https://portal.steadfast.com.bd/api/v1"
COURIER_API_KEY=""
COURIER_SECRET_KEY=""

# cPanel Shared Hosting SMTP Mailer Configuration
SMTP_HOST="mail.glowgoodly.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="noreply@glowgoodly.com"
SMTP_PASS="YourWebmailEmailPasswordHere"
MAIL_FROM="GlowGoodly <noreply@glowgoodly.com>"
