# ─── GLOWGOODLY PRODUCTION ENVIRONMENT CONFIGURATION ────────────────────────
# cPanel Shared Hosting Production Configuration

PORT=5000
NODE_ENV=production

# ─── MYSQL DATABASE CONFIGURATION ──────────────────────────────────────────
# Replace placeholders with your actual cPanel MySQL database credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpaneluser_glowuser
DB_PASSWORD=YourStrongDatabasePassword123!
DB_NAME=cpaneluser_glowgoodly

# Prisma MySQL Connection String
DATABASE_URL="mysql://cpaneluser_glowuser:YourStrongDatabasePassword123!@localhost:3306/cpaneluser_glowgoodly"

# ─── SECURITY & AUTHENTICATION ──────────────────────────────────────────────
JWT_SECRET="glowgoodly_production_jwt_secure_key_987654321_secret"
FRONTEND_URL="https://shop.glowgoodly.com"
ADMIN_EMAIL=admin@glowgoodly.com
ADMIN_PASSWORD=admin123

# ─── DOMAINS & CORS ─────────────────────────────────────────────────────────
STORE_NAME="GlowGoodly"
API_BASE_URL="https://api.glowgoodly.com/api"
FRONTEND_STORE_URL="https://shop.glowgoodly.com"
MAIN_DOMAIN="https://glowgoodly.com"

