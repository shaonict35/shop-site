# ─── SERVER CONFIGURATION ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── SQL DATABASE CONNECTION ────────────────────────────────────────────────
# Option A: Local SQLite database
DATABASE_URL="file:./dev.db"

# Option B: MySQL / MariaDB Database (cPanel / Dedicated VPS)
# DATABASE_URL="mysql://cpaneluser_dbuser:StrongPassword@localhost:3306/cpaneluser_dbname"
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=cpaneluser_dbuser
# DB_PASSWORD=StrongPassword
# DB_NAME=cpaneluser_dbname

# ─── INITIAL SUPERADMIN CREDENTIALS ─────────────────────────────────────────
ADMIN_EMAIL="admin@glowgoodly.com"
ADMIN_PASSWORD="YourStrongAdminPassword123!"

# ─── AUTHENTICATION & SECURITY ──────────────────────────────────────────────
JWT_SECRET="generate_a_long_random_jwt_secret_here"
FRONTEND_URL="https://yourstore.com"
