# ─── GLOWGOODLY BACKEND ENVIRONMENT CONFIGURATION TEMPLATE ─────────────────
# Rename/copy this file to '.env' inside the backend folder.

# ─── SERVER CONFIGURATION ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── MYSQL DATABASE CONFIGURATION (cPanel / Localhost) ──────────────────────
# Full DATABASE_URL format: mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME
DATABASE_URL="mysql://sitecadh_alamain:YourPasswordHere@localhost:3306/sitecadh_glowgoodly_db"

# Discrete credentials fallback
DB_HOST=localhost
DB_PORT=3306
DB_USER=sitecadh_alamain
DB_PASSWORD=YourPasswordHere
DB_NAME=sitecadh_glowgoodly_db

# ─── INITIAL SUPERADMIN CREDENTIALS ─────────────────────────────────────────
ADMIN_EMAIL="admin@glowgoodly.com"
ADMIN_PASSWORD="YourStrongAdminPassword123!"

# ─── AUTHENTICATION & SECURITY ──────────────────────────────────────────────
JWT_SECRET="glowgoodly_production_jwt_secure_key_987654321_secret"
FRONTEND_URL="https://shop.glowgoodly.com"

# ─── HOSTING SMTP EMAIL CONFIGURATION ────────────────────────────────────────
SMTP_HOST="mail.glowgoodly.com"
SMTP_PORT=465
SMTP_USER="admin@glowgoodly.com"
SMTP_PASS=""
SMTP_FROM_EMAIL="GlowGoodly Official <admin@glowgoodly.com>"
